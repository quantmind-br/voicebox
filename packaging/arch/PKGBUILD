# Maintainer: see https://github.com/quantmind-br/voicebox
#
# Builds Voicebox from the checkout this file lives in. Point `_repo` at a
# different tree, or run `makepkg` from a copy of this directory inside the
# repository, and it will build that instead.
#
# A note on size: the Python backend is frozen with PyInstaller and carries
# PyTorch plus the TTS model runtimes, so the built package is several
# gigabytes and the build needs roughly 25 GB of scratch space. That is
# inherent to shipping a self-contained ML backend, not to this packaging —
# the macOS and Windows builds are the same shape. If that is not the trade
# you want, run from source instead (see docs/linux/arch-hyprland.md); the
# app is identical, it just uses the repo's venv rather than a frozen copy.

pkgname=voicebox
pkgver=0.5.0
pkgrel=1
pkgdesc="Local text-to-speech, voice cloning, and system-wide dictation"
arch=('x86_64')
url="https://github.com/quantmind-br/voicebox"
license=('MIT')

# !lto — makepkg enables LTO globally, which puts `-flto=auto` into CFLAGS.
#   The `ring` crate builds its curve25519/p256 assembly through the `cc`
#   crate, so those objects come out as GCC LTO bitcode, and the rust-lld
#   that links the Rust side cannot read them. The build dies with a wall of
#   `undefined symbol: ring_core_0_17_14__*` at the final link, long after
#   anything that would hint at LTO.
# !strip — the sidecars are PyInstaller one-file executables: an ELF with a
#   multi-gigabyte archive appended. Stripping rewrites section headers and
#   risks severing the loader from its payload, and there is nothing to gain
#   since the Python bytecode is not a symbol table.
# !debug — nothing useful to split out once !strip is set.
options=(!lto !strip !debug)

depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'alsa-lib'
  'libappindicator-gtk3'
  'librsvg'
  'openssl'
)
makedepends=(
  'rust'
  'cargo'
  'bun'
  'python'
  'make'
  'pkgconf'
)
optdepends=(
  'wtype: layout-correct auto-paste on Wayland (strongly recommended)'
  'wl-clipboard: command-line clipboard access for debugging'
  'hyprland: dictation overlay placement and focus restore'
  'cuda: NVIDIA GPU acceleration'
  'rocm-hip-runtime: AMD GPU acceleration'
  'pipewire-pulse: system-audio capture via monitor sources'
)

# Built in-tree from the surrounding checkout rather than fetched, so the
# package always matches the working copy under test. Nothing to download,
# and the desktop entry and udev rule are installed by `make install`
# straight from this directory rather than copied through $srcdir.
source=()
sha256sums=()

_repo="$(cd "${startdir}/../.." && pwd)"

build() {
  cd "${_repo}"
  make setup build
}

package() {
  cd "${_repo}"
  # The Makefile owns the install layout — which files go where, and why the
  # sidecars have to stay beside the main binary. Delegating keeps the two
  # from drifting apart, and means `make install` and the package produce
  # byte-identical trees.
  make install DESTDIR="${pkgdir}" PREFIX=/usr
}
